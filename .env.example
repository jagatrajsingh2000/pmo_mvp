# Copy this to .env and fill values
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-PREVIEW
AZURE_OPENAI_DEPLOYMENT=GPT-4O
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MAX_TOKENS=12000

# Local demo login used by /v1/auth/login
DEMO_ADMIN_EMAIL=Admin123@ey.com
DEMO_ADMIN_PASSWORD=Admin123@ey.com

# BRD large-document handling
# Documents above BRD_DIRECT_MAX_CHARS are processed in multiple Azure OpenAI calls:
# chunk fact extraction -> optional fact merge -> final grounded BRD synthesis.
BRD_DIRECT_MAX_CHARS=20000
BRD_CHUNK_SIZE_CHARS=14000
BRD_CHUNK_OVERLAP_CHARS=1200
BRD_FACT_BATCH_MAX_CHARS=26000
BRD_FACT_BUNDLE_MAX_CHARS=42000
